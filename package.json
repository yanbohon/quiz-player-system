{
  "name": "contestant-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:broker": "playwright test -c playwright.broker.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@arco-design/mobile-react": "2.38.1",
    "@tanstack/react-query": "^5.62.14",
    "@tanstack/react-query-devtools": "^5.62.14",
    "immer": "^10.1.1",
    "lodash": "4.17.21",
    "mqtt": "^5.11.2",
    "perfect-freehand": "^1.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.15.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tanstack/eslint-plugin-query": "^5.62.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash": "4.17.20",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "^9.19.0",
    "jsdom": "26.1.0",
    "typescript": "^5.7.3",
    "vite": "8.0.12",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  }
}
